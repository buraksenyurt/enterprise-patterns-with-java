<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Resource Definitions//EN"
        "http://glassfish.org/dtds/glassfish-resources_1_5.dtd">
<resources>
    <jdbc-connection-pool name="GameCatalogPool" res-type="javax.sql.DataSource" 
                          datasource-classname="com.mysql.cj.jdbc.MysqlDataSource">
        <property name="url"
                  value="jdbc:mysql://localhost:3306/gamecatalog?useUnicode=true&amp;characterEncoding=UTF-8&amp;serverTimezone=UTC"/>
        <property name="user" value="gamecatalog_user"/>
        <property name="password" value="GameCatalog123!"/>
    </jdbc-connection-pool>

    <jdbc-resource pool-name="GameCatalogPool" jndi-name="java:app/jdbc/gamecatalog"/>
</resources>
